    font-family: 'Aeonik Pro'; font-style: italic; font-weight: 900;
    src: local('Aeonik Pro Black Italic'), local('AeonikPro-BlackItalic');
}

/* GT Standard Mono (Code) - INCHANGÉ, COMME DEMANDÉ */
@font-face {
    font-family: 'GT Standard Mono'; font-style: normal; font-weight: 400;
    src: local('GT Standard Mono'), local('GT-Standard-Mono');
}
@font-face {
    font-family: 'GT Standard Mono'; font-style: italic; font-weight: 400;
    src: local('GT Standard Mono Oblique'), local('GT-Standard-Mono-Oblique');
}
@font-face {
    font-family: 'GT Standard Mono'; font-style: normal; font-weight: 700;
    src: local('GT Standard Mono Bold'), local('GT-Standard-Mono-Bold');
}
@font-face {
    font-family: 'GT Standard Mono'; font-style: italic; font-weight: 700;
    src: local('GT Standard Mono Bold Oblique'), local('GT-Standard-Mono-Bold-Oblique');
}

/* --- Variables & Optimisations globales --- */
:root {
    /* La variable --font-main est mise à jour pour utiliser la nouvelle police. */
    --font-main: "Aeonik Pro", "Google Sans", "Helvetica Neue", "Segoe UI", "YouTube Noto", "Roboto", sans-serif;
    /* La variable --font-mono reste INCHANGÉE. */
    --font-mono: "GT Standard Mono", "Fira Code", "Google Sans Mono", monospace;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
}

/* --- Règle globale de base (INCHANGÉE) --- */
body, body * {
    font-family: var(--font-main) !important;
}

/* --- Exceptions critiques (Code & Icônes) - (INCHANGÉES) --- */
pre, code, pre *, code *,
.code-block, .code-block *, .code-container, .code-container *,
.monaco-editor, .monaco-editor *, span[class*='mtk'],
.hljs, .hljs *, .prose pre, .notion-code-block *,
.mat-mdc-unelevated-button.gds-pillbox-button .mdc-button__label,
[class*="bg-black"] code {
    font-family: var(--font-mono) !important;
    font-style: normal !important;
    font-weight: 400 !important;
    font-variant-ligatures: none !important;
}

pre b, code b, pre strong, code strong, .hljs-strong, .cm-strong {
    font-family: var(--font-mono) !important;
    font-weight: 700 !important;
    font-style: normal !important;
}
pre i, code i, pre em, code em, .hljs-emphasis, .cm-em {
    font-family: var(--font-mono) !important;
    font-style: italic !important;
    font-weight: 400 !important;
}

.google-symbols, [class*="google-symbols"],
.material-icons, mat-icon, yt-icon, .notion-icon,
[data-radix-collection-item] svg, ytd-topbar-menu-button-renderer svg,
.yt-spec-icon-shape {
    font-family: 'Google Symbols', 'Material Icons', 'YouTube Noto', 'Roboto', sans-serif !important;
    font-feature-settings: 'liga' !important;
    font-synthesis: none !important;
    text-rendering: auto !important;
    font-variant: normal !important;
    text-transform: none !important;
    font-weight: normal !important;
    font-style: normal !important;
}

