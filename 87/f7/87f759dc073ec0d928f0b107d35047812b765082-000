/* --- AEONIK Définitions @font-face (Chargées une seule fois) --- */

/* Aeonik Pro (remplace GT Standard pour UI & Texte) */
/* Chaque graisse est définie individuellement, comme dans la structure originale. */
@font-face {
    font-family: 'Aeonik Pro'; font-style: normal; font-weight: 300;
    /* Les noms locaux sont adaptés pour correspondre à la famille Aeonik. */
    src: local('Aeonik Pro Light'), local('AeonikPro-Light');
}
@font-face {
    font-family: 'Aeonik Pro'; font-style: italic; font-weight: 300;
    src: local('Aeonik Pro Light Italic'), local('AeonikPro-LightItalic');
}
@font-face {
    font-family: 'Aeonik Pro'; font-style: normal; font-weight: 400;
    src: local('Aeonik Pro Regular'), local('AeonikPro-Regular');
}
@font-face {
    font-family: 'Aeonik Pro'; font-style: italic; font-weight: 400;
    src: local('Aeonik Pro Regular Italic'), local('AeonikPro-RegularItalic');
}
@font-face {
    font-family: 'Aeonik Pro'; font-style: normal; font-weight: 500;
    src: local('Aeonik Pro Medium'), local('AeonikPro-Medium');
}
@font-face {
    font-family: 'Aeonik Pro'; font-style: italic; font-weight: 500;
