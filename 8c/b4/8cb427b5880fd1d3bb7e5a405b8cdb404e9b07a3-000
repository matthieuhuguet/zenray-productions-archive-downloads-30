#!/usr/bin/env python3
import re
import sys
from pathlib import Path

CPS = 17
MIN_DUR_MS = 1500
MAX_DUR_MS = 6000
GAP_MS = 50
EMPTY_DUR_MS = 500
TC_RE = re.compile(r"^(\d{2}):(\d{2}):(\d{2}),(\d{3})\s*-->\s*(\d{2}):(\d{2}):(\d{2}),(\d{3})\s*$")


def tc_to_ms(parts):
    h, m, s, ms = map(int, parts)
    return h * 3_600_000 + m * 60_000 + s * 1000 + ms


def ms_to_tc(t):
    h, rem = divmod(max(0, int(t)), 3_600_000)
    m, rem = divmod(rem, 60_000)
    s, ms = divmod(rem, 1000)
    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"


def parse(path):
    text = Path(path).read_text(encoding="utf-8").replace("\r\n", "\n").replace("\r", "\n")
    blocks = []
    for raw in re.split(r"\n\s*\n", text.strip()):
        lines = raw.split("\n")
        if len(lines) < 2:
            continue
        m = TC_RE.match(lines[1].strip())
        if not m:
            continue
        blocks.append(
            {
                "idx": lines[0].strip(),
                "start": tc_to_ms(m.groups()[:4]),
                "end": tc_to_ms(m.groups()[4:]),
                "body": lines[2:],
            }
        )
    return blocks


def compute_duration(body):
    text = " ".join(b for b in body if b.strip() and b.strip() != "&nbsp;")
    if not text:
        return EMPTY_DUR_MS
    desired = int(len(text) / CPS * 1000)
    return max(MIN_DUR_MS, min(MAX_DUR_MS, desired))


def retime(blocks):
    out = []
    for i, b in enumerate(blocks):
        new_end = b["start"] + compute_duration(b["body"])
        if i + 1 < len(blocks):
            limit = blocks[i + 1]["start"] - GAP_MS
            if new_end > limit:
                new_end = max(b["start"] + 500, limit)
        if new_end <= b["start"]:
            new_end = b["start"] + 500
        out.append({**b, "end": new_end})
    return out


def write(blocks, path):
    parts = [
        f"{b['idx']}\n{ms_to_tc(b['start'])} --> {ms_to_tc(b['end'])}\n" + "\n".join(b["body"])
        for b in blocks
    ]
    Path(path).write_text("\n\n".join(parts) + "\n", encoding="utf-8")


def main():
    for src in sys.argv[1:]:
        blocks = parse(src)
        retimed = retime(blocks)
        write(retimed, src)
        before = sum(b["end"] - b["start"] for b in blocks)
        after = sum(b["end"] - b["start"] for b in retimed)
        print(f"{src}: {len(blocks)} entries, {before//1000}s -> {after//1000}s")


if __name__ == "__main__":
    main()
