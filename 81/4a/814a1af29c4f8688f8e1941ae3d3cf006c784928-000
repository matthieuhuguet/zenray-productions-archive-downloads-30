#!/usr/bin/env python3
import re
import sys
from pathlib import Path

TC_RE = re.compile(r"^\d{2}:\d{2}:\d{2},\d{3}\s+-->\s+\d{2}:\d{2}:\d{2},\d{3}$")


def parse_blocks(path):
    text = Path(path).read_text(encoding="utf-8").replace("\r\n", "\n").replace("\r", "\n")
    return [b for b in re.split(r"\n\s*\n", text.strip()) if b.strip()]


def validate_blocks(blocks, label):
    nums = []
    for pos, block in enumerate(blocks, 1):
        lines = block.split("\n")
        if len(lines) < 3:
            raise ValueError(f"{label}: block {pos} has fewer than 3 lines")
        if not lines[0].strip().isdigit():
            raise ValueError(f"{label}: block {pos} index is not numeric: {lines[0]!r}")
        if not TC_RE.match(lines[1].strip()):
            raise ValueError(f"{label}: block {pos} bad timecode: {lines[1]!r}")
        nums.append(int(lines[0].strip()))
    return nums


def main():
    out = Path(sys.argv[-1])
    inputs = [Path(p) for p in sys.argv[1:-1]]
    blocks = []
    for p in inputs:
        cur = parse_blocks(p)
        validate_blocks(cur, str(p))
        blocks.extend(cur)
    nums = validate_blocks(blocks, "merged")
    expected = list(range(1, len(nums) + 1))
    if nums != expected:
        missing = sorted(set(expected) - set(nums))[:20]
        dupes = sorted({n for n in nums if nums.count(n) > 1})[:20]
        raise ValueError(f"non-contiguous numbering: missing={missing}, dupes={dupes}")
    out.write_text("\n\n".join(blocks).rstrip() + "\n", encoding="utf-8")
    print(f"wrote {out}: {len(blocks)} entries")


if __name__ == "__main__":
    main()
